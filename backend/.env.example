PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bus_ticket_system"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
FRONTEND_URL="https://bus-ticket-system-beta.vercel.app"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM_EMAIL="your-gmail@gmail.com"
SMTP_FROM_NAME="EasyTrip Support"

# SSLCommerz (optional; falls back to STORE_ID / STORE_PASSWORD / SSLCOMMERZ_URL)
SSL_STORE_ID=""
SSL_STORE_PASS=""
SSL_BASE_URL="https://sandbox.sslcommerz.com"
# Full refund API URL (optional). If unset, derived from SSL_BASE_URL or SSLCOMMERZ_URL origin.
SSL_REFUND_URL="https://sandbox.sslcommerz.com/validator/api/merchantTransIDvalidationAPI.php"
STORE_ID=""
STORE_PASSWORD=""
SSLCOMMERZ_URL="https://sandbox.sslcommerz.com/gwprocess/v4/api.php"
BACKEND_URL="http://localhost:3000"

# Seat hold before "Proceed to payment" (minutes). Payment window after confirm is separate.
SEAT_SELECTION_LOCK_MINUTES=2
# Optional override for dashboard/staff seat holds (defaults to SEAT_SELECTION_LOCK_MINUTES).
DASHBOARD_SEAT_LOCK_MINUTES=2
# Minutes after booking confirm until payment must complete (matches seat lock UX by default).
BOOKING_PAYMENT_TIMEOUT_MINUTES=2