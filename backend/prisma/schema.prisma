generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum UserRole {
  ADMIN
  OPERATOR
  STAFF
  USER
}

enum OperatorStatus {
  ACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BusType {
  AC
  NON_AC
  SLEEPER
}

enum BusClass {
  BUSINESS
  ECONOMY
}

enum BusStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum TripStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum BookingSeatStatus {
  LOCKED
  RESERVED
  CANCELLED
}

enum PaymentMethod {
  BKASH
  NAGAD
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  FAILED
}

//////////////////////////////////////////////////////
// OPERATOR
//////////////////////////////////////////////////////

model Operator {
  id          String          @id @default(cuid())
  companyName String          @unique
  slug        String          @unique
  logo        String?
  email       String?
  phone       String?
  address     String?
  description String?
  status      OperatorStatus  @default(ACTIVE)

  users       User[]
  buses       Bus[]
  routes      Route[]
  trips       Trip[]
  bookings    Booking[]
  payments    Payment[]
  refunds     Refund[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([slug])
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id                String   @id @default(cuid())
  fullName          String
  email             String   @unique
  passwordHash      String
  phoneNumber       String?
  gender            Gender?
  address           String?
  dateOfBirth       DateTime?
  nationalId        String?
  passportNumber    String?
  visaInfo          String?
  role              UserRole @default(USER)
  operatorId        String?
  refreshTokenHash  String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  operator          Operator? @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  bookings          Booking[]
  payments          Payment[]
  refunds           Refund[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([operatorId])
  @@index([role])
}

//////////////////////////////////////////////////////
// BUS
//////////////////////////////////////////////////////

model Bus {
  id                 String   @id @default(cuid())
  name               String
  operatorId         String
  registrationNumber String   @unique
  seatCapacity       Int
  busType            BusType
  busClass           BusClass @default(ECONOMY)
  status             BusStatus @default(ACTIVE)

  operator           Operator @relation(fields: [operatorId], references: [id])
  seats              Seat[]
  trips              Trip[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([operatorId])
  @@index([operatorId, status])
}

//////////////////////////////////////////////////////
// ROUTE
//////////////////////////////////////////////////////

model Route {
  id          String   @id @default(cuid())
  operatorId  String
  origin      String
  destination String

  operator    Operator @relation(fields: [operatorId], references: [id])
  trips       Trip[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([operatorId, origin, destination])
  @@index([operatorId])
  @@index([origin, destination])
}

//////////////////////////////////////////////////////
// TRIP
//////////////////////////////////////////////////////

model Trip {
  id             String      @id @default(cuid())
  busId          String
  routeId        String
  operatorId     String
  boardingPoint  String
  droppingPoint  String

  departureTime  DateTime
  arrivalTime    DateTime
  price          Decimal     @db.Decimal(10, 2)

  status         TripStatus  @default(SCHEDULED)
  cancelledAt    DateTime?
  cancelReason   String?
  cancelledBy    String?

  bus            Bus         @relation(fields: [busId], references: [id], onDelete: Restrict)
  route          Route       @relation(fields: [routeId], references: [id], onDelete: Restrict)
  operator       Operator    @relation(fields: [operatorId], references: [id])

  bookings       Booking[]
  bookingSeats   BookingSeat[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([busId])
  @@index([routeId])
  @@index([operatorId])
  @@index([departureTime])
  @@index([status, departureTime])
  @@unique([routeId, busId, departureTime])
}

//////////////////////////////////////////////////////
// SEAT
//////////////////////////////////////////////////////

model Seat {
  id           String   @id @default(cuid())
  busId        String
  seatNumber   String

  rowNumber    Int?
  columnNumber Int?

  bus          Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  bookingSeats BookingSeat[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([busId, seatNumber])
}

//////////////////////////////////////////////////////
// BOOKING
//////////////////////////////////////////////////////

model Booking {
  id               String         @id @default(cuid())
  bookingReference String         @unique

  userId           String
  tripId           String
  operatorId       String

  passengerName    String
  passengerPhone   String

  totalAmount      Decimal        @db.Decimal(10, 2)

  paymentExpiresAt DateTime?

  status           BookingStatus  @default(PENDING)
  bookingSource    String         @default("USER_BOOKING")
  discountType     String?
  discountValue    Decimal?       @db.Decimal(10, 2)
  discountAmount   Decimal?       @db.Decimal(10, 2)
  finalAmount      Decimal?       @db.Decimal(10, 2)
  refundAmount     Decimal?       @db.Decimal(10, 2)
  cancelledAt      DateTime?
  cancelReason     String?
  cancelledBy      String?

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip             Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  operator         Operator       @relation(fields: [operatorId], references: [id])

  bookingSeats     BookingSeat[]
  payments         Payment[]
  refunds          Refund[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([operatorId])
  @@index([tripId])
  @@index([status])
}

//////////////////////////////////////////////////////
// BOOKING SEAT (CRITICAL)
//////////////////////////////////////////////////////

model BookingSeat {
  id            String            @id @default(cuid())

  bookingId     String?
  tripId        String
  seatId        String

  price         Decimal           @db.Decimal(10, 2)
  status        BookingSeatStatus @default(LOCKED)
  lockExpiresAt DateTime?

  booking       Booking?          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  trip          Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seat          Seat              @relation(fields: [seatId], references: [id], onDelete: Restrict)

  createdAt     DateTime          @default(now())

  @@unique([tripId, seatId])
}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

model Payment {
  id            String        @id @default(cuid())

  bookingId     String
  userId        String
  operatorId    String

  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  refundAmount  Decimal?      @db.Decimal(10, 2)
  refundStatus  String?

  transactionId String?       @unique
  valId         String?
  bankTranId    String?

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  operator      Operator      @relation(fields: [operatorId], references: [id])

  refunds       Refund[]

  createdAt     DateTime @default(now())

  @@index([bookingId])
  @@index([operatorId])
  @@index([status])
}

//////////////////////////////////////////////////////
// REFUND
//////////////////////////////////////////////////////

model Refund {
  id          String       @id @default(cuid())

  bookingId   String
  paymentId   String?
  userId      String
  operatorId  String

  reason      String
  amount      Decimal      @db.Decimal(10, 2)
  status      RefundStatus @default(PENDING)
  processedAt DateTime?
  processedBy String?
  adminNote   String?

  bankTranId        String?
  sslRefundRefId    String?
  refundTransId     String?  @unique
  sslGatewayStatus  String?
  sslRawResponse    Json?

  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment     Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  operator    Operator     @relation(fields: [operatorId], references: [id])

  createdAt   DateTime @default(now())

  @@index([bookingId])
  @@index([operatorId])
  @@index([status])
}
